rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{userId} {
      // Anyone can READ a profile — this is required so the public
      // /e/:userId emergency page works without login when a QR is scanned.
      allow read: if true;

      // The signed-in owner can write anything on their own profile.
      allow write: if request.auth != null && request.auth.uid == userId;

      // Emergency contacts (not logged in) are allowed to subscribe their device
      // for push alerts — but ONLY by adding to contactTokens, nothing else.
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactTokens']);
    }
  }
}
