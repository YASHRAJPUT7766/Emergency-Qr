rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{userId} {
      // Anyone can READ a profile — this is required so the public
      // /e/:userId emergency page works without login when a QR is scanned.
      allow read: if true;

      // Only the signed-in owner can create/edit their own profile.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
